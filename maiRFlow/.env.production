# ─── ReceiptFlow AI — Production Environment Template ────────────────────────
# This file is TRACKED IN GIT — it is a template only.
# Copy to .env.production.local on your deployment host and fill in real values.
# NEVER commit actual secrets.
#
# All values marked REQUIRED must be set or the application will refuse to start.

NODE_ENV=production

# ─── Database ────────────────────────────────────────────────────────────────
# REQUIRED — use a connection pooler (e.g. PgBouncer) URL in production
DATABASE_URL=REQUIRED

# ─── Redis ───────────────────────────────────────────────────────────────────
# REQUIRED — use a managed Redis instance (ElastiCache, Upstash, etc.)
REDIS_URL=REQUIRED

# ─── API Server ──────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
# Tune per load-balancer health-check interval (keep-alive > LB idle timeout)
SERVER_TIMEOUT_MS=30000
KEEP_ALIVE_TIMEOUT_MS=65000

# ─── Auth / Encryption ───────────────────────────────────────────────────────
# REQUIRED — 64-char hex (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REQUIRED
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# REQUIRED — 32-char hex (16 bytes)
ENCRYPTION_KEY=REQUIRED

# ─── Storage ─────────────────────────────────────────────────────────────────
# REQUIRED — set to 's3' or 'r2' in production
STORAGE_PROVIDER=s3
S3_BUCKET=REQUIRED
AWS_REGION=REQUIRED
AWS_ACCESS_KEY_ID=REQUIRED
AWS_SECRET_ACCESS_KEY=REQUIRED
# For Cloudflare R2 instead:
# STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=REQUIRED
# R2_BUCKET=REQUIRED
# R2_ACCESS_KEY_ID=REQUIRED
# R2_SECRET_ACCESS_KEY=REQUIRED

# ─── AI provider ─────────────────────────────────────────────────────────────
# REQUIRED
AI_PROVIDER=openai
AI_API_KEY=REQUIRED

# ─── OCR provider ────────────────────────────────────────────────────────────
# REQUIRED — choose one: textract | documentai | formrecognizer
OCR_PROVIDER=textract
# textract uses same AWS credentials as storage (above)
# For documentai:
# GCP_PROJECT_ID=REQUIRED
# DOCUMENTAI_PROCESSOR_ID=REQUIRED
# DOCUMENTAI_LOCATION=us
# For formrecognizer:
# AZURE_FORM_RECOGNIZER_ENDPOINT=REQUIRED
# AZURE_FORM_RECOGNIZER_KEY=REQUIRED

# ─── Email ───────────────────────────────────────────────────────────────────
# REQUIRED — choose one: smtp | sendgrid | resend
EMAIL_PROVIDER=sendgrid
EMAIL_FROM_ADDRESS=REQUIRED
EMAIL_FROM_NAME=ReceiptFlow
SENDGRID_API_KEY=REQUIRED
# For SMTP:
# SMTP_HOST=REQUIRED
# SMTP_PORT=587
# SMTP_USER=REQUIRED
# SMTP_PASS=REQUIRED
# SMTP_SECURE=true

# ─── Billing (Stripe live mode) ──────────────────────────────────────────────
# REQUIRED
STRIPE_SECRET_KEY=REQUIRED
STRIPE_WEBHOOK_SECRET=REQUIRED
STRIPE_API_VERSION=2024-06-20
STRIPE_PRICE_GROWTH=REQUIRED
STRIPE_PRICE_PROFESSIONAL=REQUIRED
STRIPE_PRICE_FIRM=REQUIRED

# ─── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
BODY_SIZE_LIMIT=10mb

# ─── OCR job config ──────────────────────────────────────────────────────────
OCR_JOB_ATTEMPTS=3
OCR_JOB_BACKOFF_DELAY_MS=5000

# ─── Worker concurrency (tune to instance CPU count) ─────────────────────────
OCR_CONCURRENCY=5
CATEGORIZATION_CONCURRENCY=10
NOTIFICATION_CONCURRENCY=20
JOURNAL_CONCURRENCY=10
WEBHOOK_CONCURRENCY=25
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BACKOFF_BASE_MS=1000
WEBHOOK_REQUEST_TIMEOUT_MS=15000
WEBHOOK_MAX_RESPONSE_BODY_BYTES=4096
