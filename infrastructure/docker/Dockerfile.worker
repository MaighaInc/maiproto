FROM node:22-alpine AS base
RUN npm install -g turbo@^2
WORKDIR /app

FROM base AS pruner
COPY . .
RUN turbo prune @receiptflow/worker --docker

FROM base AS installer
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/package-lock.json ./package-lock.json
RUN npm ci --frozen-lockfile

COPY --from=pruner /app/out/full/ .
RUN turbo run build --filter=@receiptflow/worker

FROM node:22-alpine AS runner
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 receiptflow
WORKDIR /app
ENV NODE_ENV=production

COPY --from=installer --chown=receiptflow:nodejs /app/apps/worker/dist ./apps/worker/dist
COPY --from=installer --chown=receiptflow:nodejs /app/node_modules ./node_modules
COPY --from=installer --chown=receiptflow:nodejs /app/apps/worker/package.json ./apps/worker/package.json

USER receiptflow
CMD ["node", "apps/worker/dist/main.js"]
