# ────────────────────────────────────────────────────────────────────────────
# Environment
# ────────────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ────────────────────────────────────────────────────────────────────────────
# API
# ────────────────────────────────────────────────────────────────────────────
API_PORT=4000
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# ────────────────────────────────────────────────────────────────────────────
# Database
# ────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://receiptflow:receiptflow@localhost:5432/receiptflow?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# ────────────────────────────────────────────────────────────────────────────
# Redis
# ────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ────────────────────────────────────────────────────────────────────────────
# JWT
# ────────────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-at-least-64-chars-long
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-secret-at-least-64-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ────────────────────────────────────────────────────────────────────────────
# Encryption
# ────────────────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=change-this-to-32-bytes-hex-encoded-key-must-be-64-hex-chars-here

# ────────────────────────────────────────────────────────────────────────────
# Storage
# ────────────────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local   # local | s3 | r2
STORAGE_LOCAL_PATH=./uploads

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=receiptflow-receipts

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=receiptflow-receipts
R2_PUBLIC_URL=

# ────────────────────────────────────────────────────────────────────────────
# OCR
# ────────────────────────────────────────────────────────────────────────────
OCR_PROVIDER=textract   # textract | documentai | formrecognizer

# AWS Textract (uses AWS credentials above)
TEXTRACT_REGION=us-east-1

# Google Document AI
GOOGLE_PROJECT_ID=
GOOGLE_LOCATION=us
GOOGLE_DOCAI_PROCESSOR_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Azure Form Recognizer
AZURE_FORM_RECOGNIZER_ENDPOINT=
AZURE_FORM_RECOGNIZER_KEY=

# ────────────────────────────────────────────────────────────────────────────
# AI
# ────────────────────────────────────────────────────────────────────────────
AI_PROVIDER=openai   # openai | claude | gemini

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# ────────────────────────────────────────────────────────────────────────────
# Email
# ────────────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=smtp   # smtp | sendgrid | resend
EMAIL_FROM=noreply@receiptflow.ai
EMAIL_FROM_NAME=ReceiptFlow AI

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

SENDGRID_API_KEY=
RESEND_API_KEY=

# ────────────────────────────────────────────────────────────────────────────
# Slack
# ────────────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# ────────────────────────────────────────────────────────────────────────────
# Stripe
# ────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ────────────────────────────────────────────────────────────────────────────
# Frontend
# ────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ────────────────────────────────────────────────────────────────────────────
# Monitoring
# ────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=
