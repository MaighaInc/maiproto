    "@receiptflow/shared": "*",
    "@receiptflow/storage": "*",
    "bullmq": "^5.8.0",
    "ioredis": "^5.4.1",
    "pino": "^9.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "rimraf": "^6.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
