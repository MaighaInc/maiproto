{
  "name": "receiptflow",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=\"./packages/*\"",
    "build:api": "turbo run build --filter=@receiptflow/api",
    "build:worker": "turbo run build --filter=@receiptflow/worker",
    "build:web": "turbo run build --filter=@receiptflow/web",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@receiptflow/api",
    "dev:worker": "turbo run dev --filter=@receiptflow/worker",
    "dev:web": "turbo run dev --filter=@receiptflow/web",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "turbo run typecheck",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.3.0",
    "rimraf": "^6.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.8.0",
  "dependencies": {
    "pino-pretty": "^13.1.3"
  }
}
